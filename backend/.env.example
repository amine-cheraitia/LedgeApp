APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Compte administrateur initial (utilise par AdminUserSeeder)
# En production : ADMIN_PASSWORD est OBLIGATOIRE (chaine aleatoire generee, jamais commitee).
# En local/test : laisser vide -> retombe sur le mot de passe de dev "password".
ADMIN_EMAIL=admin@ledge.dz
ADMIN_PASSWORD=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — piloté par .env, aucun changement de code pour switcher de fournisseur :
#  - Dev / recette  : Mailpit (catch-all local, UI http://localhost:8025) -> MAIL_HOST=127.0.0.1 MAIL_PORT=1025
#  - Démo réelle    : Brevo (gratuit 300/j) -> MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_SCHEME=tls
#                     MAIL_USERNAME=<login Brevo> MAIL_PASSWORD=<clé SMTP>
#  - Tests auto     : MAIL_MAILER=array (aucun envoi réel)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cabinet@ledge.dz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supervision
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
HEALTH_SECRET_TOKEN=
