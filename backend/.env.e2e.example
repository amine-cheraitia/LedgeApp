# Template de l'environnement DEDIE aux tests E2E Playwright.
# Copie automatiquement en .env.e2e (NON versionne) au chargement de la config
# Playwright (frontend/e2e/ensure-env.ts), qui genere aussi APP_KEY localement :
# une cle fonctionnelle n'a rien a faire dans git (constat audit 2026-07-17).
# Aucune donnee reelle : base isolee ledge_e2e, mail en memoire.
# Ne JAMAIS pointer DB_DATABASE sur la base de dev « ledge ».

APP_NAME=Ledge
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

FRONTEND_URL=http://localhost:5174

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ledge_e2e
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

TELESCOPE_ENABLED=false

# Comptes seedes pour les tests (AdminUserSeeder + E2eSeeder).
# « password » est le repli standard du seeder hors production — pas un secret.
ADMIN_EMAIL=admin@ledge.dz
ADMIN_PASSWORD=password
