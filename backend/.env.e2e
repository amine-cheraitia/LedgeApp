# Environnement DEDIE aux tests E2E Playwright — versionne volontairement
# (comme .env.docker) : aucune donnee reelle, base isolee ledge_e2e, cle de
# test. Charge par APP_ENV=e2e (php artisan serve --env=e2e / migrate --env=e2e).
# Ne JAMAIS pointer DB_DATABASE sur la base de dev « ledge ».

APP_NAME=Ledge
APP_ENV=e2e
APP_KEY=base64:zDeGlB0wmu/rxGGS5IsuNimwQLY7OH+lntHDEjv25kg=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

FRONTEND_URL=http://localhost:5174

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ledge_e2e
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

TELESCOPE_ENABLED=false

# Comptes seedes pour les tests (AdminUserSeeder + E2eSeeder)
ADMIN_EMAIL=admin@ledge.dz
ADMIN_PASSWORD=password
