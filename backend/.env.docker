# Configuration backend pour la stack Docker de demonstration (docker-compose.yml).
# Copiee automatiquement en .env au premier demarrage (voir docker/php/entrypoint.sh).
# NE PAS utiliser tel quel en production (voir docs/MANUEL-DEPLOIEMENT.md).

APP_NAME=Ledge
APP_ENV=local
APP_KEY=
# Demo locale : debug active pour diagnostiquer facilement. En production -> false.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# SPA Vue servie par le conteneur frontend
FRONTEND_URL=http://localhost:5173

BCRYPT_ROUNDS=12
AUTH_PASSWORD_RESET_EXPIRE=1440

# Compte administrateur initial.
# Le mot de passe est fourni par docker-compose (variable ADMIN_PASSWORD,
# defaut Ledge@Demo2026) : laisser vide ici pour que l'env conteneur prime.
ADMIN_EMAIL=admin@ledge.dz
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de donnees : service `mysql` du reseau Docker (port interne 3306)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ledge
DB_USERNAME=ledge
DB_PASSWORD=secret

# Authentification SPA (Sanctum, cookies) : les deux origines locales
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

TELESCOPE_ENABLED=false
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Demo : jobs executes en ligne (aucun worker a lancer).
# Production -> QUEUE_CONNECTION=redis + service `queue`.
QUEUE_CONNECTION=sync

# Cache : service `redis` du reseau Docker
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail : ecrit dans les logs (storage/logs/laravel.log). Aucun envoi reel.
# Les liens d'invitation / reinitialisation restent visibles cote admin
# (lien copiable) et dans les logs. Voir docs/MANUEL-DEPLOIEMENT.md pour Brevo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="cabinet@ledge.dz"
MAIL_FROM_NAME="${APP_NAME}"

# Supervision (optionnel en demo)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
HEALTH_SECRET_TOKEN=
